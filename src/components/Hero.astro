---
// Hero section — series branding + current book cover
---

<section id="hero" class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="series-badge">📚 A Children's Book Series</p>
      <h1 class="hero-title">
        Learning is an <em>adventure</em> — and Papi can't wait to see!
      </h1>
      <p class="hero-sub">
        Follow along as kids show Papi everything they know — letters, numbers,
        and so much more. The <strong>Show Papi</strong> series makes early
        learning joyful, confident, and full of love.
      </p>
      <div class="hero-cta">
        <a href="#buy" class="btn btn-primary">🛒 Get the Book</a>
        <a href="#series" class="btn btn-outline">Explore the Series</a>
      </div>
    </div>

    <div class="hero-cover">
      <div class="cover-wrapper">
        <img
          src="/images/abcs-cover.png"
          alt="Book cover: I'll Show Papi… I Know My ABCs"
          width="340"
          height="420"
          loading="eager"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="cover-placeholder" aria-hidden="true">
          <span>📖</span>
          <p>I'll Show Papi…<br />I Know My ABCs</p>
        </div>
      </div>
      <div class="cover-badge">Book 1 — Available Now!</div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, #fff9f0 0%, #fff3d6 100%);
    padding: 5rem 1.5rem 4rem;
    overflow: hidden;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 80% 20%, rgba(255, 205, 60, 0.25) 0%, transparent 60%),
                      radial-gradient(circle at 10% 80%, rgba(78, 205, 196, 0.18) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .series-badge {
    display: inline-block;
    background: var(--color-sunshine);
    color: var(--color-navy);
    font-weight: 800;
    font-size: 0.875rem;
    padding: 0.35rem 1rem;
    border-radius: 3rem;
    margin-bottom: 1.25rem;
    letter-spacing: 0.03em;
  }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--color-navy);
    margin-bottom: 1.25rem;
  }

  .hero-title em {
    font-style: normal;
    color: var(--color-coral);
  }

  .hero-sub {
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 48ch;
    margin-bottom: 2rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* Cover */
  .hero-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cover-wrapper {
    position: relative;
    width: 310px;
    border-radius: 1.25rem;
    box-shadow: var(--shadow), 0 0 0 6px var(--color-sunshine);
    overflow: hidden;
    background: #e8e0d4;
  }

  .cover-wrapper img {
  width: 100%;
  height: auto;                    /* Let image keep natural ratio */
  display: block;
  border-radius: 1.25rem;
  object-fit: contain;             /* Show full image without cropping */
  }

  .cover-placeholder {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 340px;
    background: linear-gradient(135deg, #ffe082, #ffb300);
    border-radius: 1.25rem;
    padding: 2rem;
    text-align: center;
  }

  .cover-placeholder span {
    font-size: 4rem;
  }

  .cover-placeholder p {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--color-navy);
    line-height: 1.3;
  }

  .cover-badge {
    background: var(--color-coral);
    color: #fff;
    font-weight: 800;
    font-size: 0.875rem;
    padding: 0.4rem 1.2rem;
    border-radius: 3rem;
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-cover {
      order: -1;
    }

    .hero-sub {
      margin-inline: auto;
    }

    .hero-cta {
      justify-content: center;
    }
  }
</style>
