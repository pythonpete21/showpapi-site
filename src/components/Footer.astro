---
// Footer
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand" aria-label="Show Papi — Home">
        <span>📚</span>
        <span>Show Papi</span>
      </a>
      <p>A children's book series celebrating learning, love, and family.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <h4>Explore</h4>
      <ul>
        <li><a href="#series">About the Series</a></li>
        <li><a href="#featured">Book 1: ABCs</a></li>
        <li><a href="#coming-soon">Coming Soon</a></li>
        <li><a href="#about">About the Author</a></li>
      </ul>
    </nav>

    <div class="footer-contact">
      <h4>Connect</h4>
      <ul>
        <li><a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="mailto:hello@showpapi.com">hello@showpapi.com</a></li>
        <li><a href="#signup">Newsletter</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} Show Papi. All rights reserved.</p>
      <p class="footer-tagline">Made with ❤️ for curious kids everywhere.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: rgba(255, 255, 255, 0.8);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .footer-brand .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 900;
    font-size: 1.2rem;
    color: #fff;
    text-decoration: none;
    margin-bottom: 0.75rem;
  }

  .footer-brand .brand span:first-child {
    font-size: 1.4rem;
  }

  .footer-brand p {
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 28ch;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-nav h4,
  .footer-contact h4 {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-sunshine);
    margin-bottom: 1rem;
  }

  .footer-nav ul,
  .footer-contact ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav a,
  .footer-contact a {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: #fff;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.25rem 1.5rem;
  }

  .footer-bottom .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-bottom p {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.45);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom .container {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
